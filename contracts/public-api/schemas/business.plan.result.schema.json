                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "maxLength": 240
                            },
                            "title": {
                              "type": "string"
                            },
                            "loadWhen": {
                              "type": "string",
                              "maxLength": 400
                            },
                            "sectionId": {
                              "type": "string",
                              "maxLength": 160
                            },
                            "revision": {
                              "type": "string",
                              "maxLength": 160
                            }
                          },
                          "required": [
                            "path",
                            "title",
                            "loadWhen"
