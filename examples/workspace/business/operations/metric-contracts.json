      "assignmentUnit": "subject",
      "assignmentOwner": "revenuecat",
      "eligibility": "New users who reach the paywall in the reference environment.",
      "exposureRule": "Count only subjects who saw the paywall treatment, not assignment alone.",
      "decisionHorizon": "P14D",
      "primaryMetricDefinitionId": "recognized_revenue",
      "primaryMetricDefinitionRevision": 1,
      "guardrails": ["refund_rate", "crash_free_sessions"],
      "stoppingPolicy": "Do not declare a winner before the decision horizon or while the primary window is immature.",
