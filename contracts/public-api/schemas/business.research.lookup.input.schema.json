{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "query": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "connectionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            ]
          }
        }
      },
      "required": [
        "provider",
        "providerVersion",
        "connectionRef",
        "operation",
        "parameters"
      ],
      "additionalProperties": false
    },
    "maxAgeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2592000
    }
  },
  "required": [
    "workspaceId",
    "query",
    "maxAgeSeconds"
  ],
  "additionalProperties": false
}
