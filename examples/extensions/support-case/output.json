{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "priority": {
      "enum": ["normal", "urgent"]
    },
    "draftResponse": {
      "type": "string",
      "minLength": 12
    }
  },
  "required": ["caseId", "priority", "draftResponse"],
  "additionalProperties": false
}
