{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "completion": {
              "type": "object",
              "properties": {
                "deliveryAccepted": {
                  "type": "boolean"
                },
                "closeoutWorkflowId": {
                  "type": "string"
                },
                "requiredCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "excludedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outstandingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "assessed": {
                  "type": "boolean"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "deliveryAccepted",
                "closeoutWorkflowId",
                "requiredCount",
                "excludedCount",
                "outstandingCount",
                "assessed",
                "nextAction"
              ],
              "additionalProperties": true
            },
            "workspaceId": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "runId": {
              "type": [
                "string",
                "null"
              ]
            },
            "planId": {
              "type": [
                "string",
                "null"
              ]
            },
            "outcome": {
              "type": "string"
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "held": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "replayed": {
              "type": "boolean"
            },
            "scope": {
              "type": "string",
              "const": "bounded_session"
            },
            "notifications": {
              "type": "string",
              "const": "disabled"
            },
            "providerProof": {
              "type": "string",
              "const": "not_observed"
            }
          },
          "required": [
            "completion",
            "workspaceId",
            "requestId",
            "runId",
            "planId",
            "outcome",
            "completed",
            "held",
            "replayed",
            "scope",
            "notifications",
            "providerProof"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
