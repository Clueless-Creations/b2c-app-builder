{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "declarationValid": {
              "type": "boolean",
              "const": true
            },
            "proposalDigest": {
              "type": "string"
            },
            "recipe": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9.-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": true
            },
            "target": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string",
                  "enum": [
                    "ios",
                    "android",
                    "web",
                    "host"
                  ]
                },
                "runtime": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "platform",
                "runtime"
              ],
              "additionalProperties": true
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "maxLength": 160,
                    "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9.-]*$"
                  },
                  "provider": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 160,
                        "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9.-]*$"
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+\\.\\d+$"
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ],
                    "additionalProperties": true
                  },
                  "connection": {
                    "type": "string",
                    "maxLength": 160,
                    "pattern": "^connection:[a-z][a-z0-9._-]*$"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "recipe",
                      "explicit"
                    ]
                  }
                },
                "required": [
                  "operation",
                  "provider",
                  "source"
                ],
                "additionalProperties": true
              }
            },
            "canApply": {
              "type": "boolean"
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "COMPOSITION_APPLY_UNAVAILABLE",
                      "PROVIDER_EXECUTION_UNAVAILABLE",
                      "UNSUPPORTED_TARGET"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "maxLength": 160,
                    "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9.-]*$"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": true
              }
            },
            "configuration": {
              "type": "string",
              "enum": [
                "not_checked",
                "ready",
                "blocked"
              ]
            },
            "authority": {
              "type": "string",
              "enum": [
                "not_checked",
                "granted",
                "required"
              ]
            },
            "verification": {
              "type": "string",
              "enum": [
                "not_checked",
                "verified",
                "failed"
              ]
            }
          },
          "required": [
            "declarationValid",
            "proposalDigest",
            "recipe",
            "target",
            "bindings",
            "canApply",
            "blockers",
            "configuration",
            "authority",
            "verification"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
