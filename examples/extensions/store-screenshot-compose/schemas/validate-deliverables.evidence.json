{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validate-deliverables evidence",
  "description": "A saved validation report. It proves consistency of the deliverables at the moment the host ran the check. It is not design acceptance, store acceptance, or capture evidence. The host records the time and the package digest in its own receipt.",
  "type": "object",
  "properties": {
    "ok": { "type": "boolean" },
    "mode": { "const": "validate" },
    "notCaptureEvidence": { "const": true },
    "checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "dir": { "type": "string", "minLength": 1 },
          "outputs": { "type": "integer", "minimum": 0 },
          "captures": { "type": "integer", "minimum": 0 }
        },
        "required": ["dir", "outputs", "captures"],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "dir": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        },
        "required": ["code", "dir", "message"],
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["ok", "mode", "notCaptureEvidence", "checked", "failures", "warnings"],
  "additionalProperties": false
}
