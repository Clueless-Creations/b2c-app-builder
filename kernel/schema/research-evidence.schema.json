{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:b2c:core:research-evidence-schema",
  "title": "Research Evidence (strategy/RESEARCH.md)",
  "$comment": "Structural floor only. checks/validation/business/research/check-research-evidence.ts stays the sole content-quality authority (vanity-response detection, generic-option-menu detection, owned-relationship-absence detection, placeholder scanning) — this schema does not re-implement any of that judgment. It encodes the required sections as typed rows, the ID/date grammar check-research-evidence.ts already enforces, and nothing else. A document can satisfy this schema and still fail check-research-evidence.ts's content gate; that is by design, not a gap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceCaptureProtocol",
    "untrustedContentNote",
    "sourceLedger",
    "decisionInputs",
    "decisionLog",
    "rejectedClaims",
    "categoryRevenue",
    "distributionProof",
    "transformationDemo",
    "distributionFirstNiche",
    "verdict"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "evidenceCaptureProtocol": { "type": "string", "minLength": 1 },
    "untrustedContentNote": { "type": "string", "minLength": 1 },
    "sourceLedger": { "type": "array", "items": { "$ref": "#/$defs/sourceLedgerRow" } },
    "decisionInputs": { "type": "string", "minLength": 1 },
    "decisionLog": { "type": "string", "minLength": 1 },
    "rejectedClaims": { "type": "string", "minLength": 1 },
    "categoryRevenue": { "$ref": "#/$defs/categoryRevenue" },
    "distributionProof": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distributionProofRow" } },
    "transformationDemo": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transformationDemoRow" } },
    "distributionFirstNiche": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distributionFirstNicheRow" } },
    "verdict": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verdictRow" } }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "idList": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[A-Z0-9][A-Z0-9_-]*(\\s*,\\s*[A-Z][A-Z0-9_-]*-[A-Z0-9][A-Z0-9_-]*)*$"
    },
    "sourceLedgerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "platform",
        "identity",
        "observedAt",
        "backendQuery",
        "transcriptVisual",
        "observation",
        "inference",
        "confidence",
        "artifactTrace"
      ],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "platform": { "$ref": "#/$defs/nonEmptyString" },
        "identity": { "$ref": "#/$defs/nonEmptyString" },
        "observedAt": { "type": "string", "format": "date-time" },
        "backendQuery": { "$ref": "#/$defs/nonEmptyString" },
        "transcriptVisual": { "$ref": "#/$defs/nonEmptyString" },
        "observation": { "$ref": "#/$defs/nonEmptyString" },
        "inference": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "artifactTrace": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "categoryRevenue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "statedBar", "passFail"],
      "properties": {
        "rows": { "type": "array", "items": { "$ref": "#/$defs/categoryRevenueRow" } },
        "statedBar": { "type": "string", "minLength": 1, "pattern": "\\d" },
        "passFail": { "enum": ["pass", "fail"] }
      }
    },
    "categoryRevenueRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "competitor", "estAnnualRevenueUsd", "sourceLabel", "observedAt"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "competitor": { "$ref": "#/$defs/nonEmptyString" },
        "estAnnualRevenueUsd": { "type": "number", "exclusiveMinimum": 0 },
        "sourceLabel": { "type": "string", "minLength": 1, "pattern": "\\d{4}-\\d{2}-\\d{2}" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "distributionProofRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audienceSegment", "exactDiscoveryLocation", "nativeFormat", "ownedRelationship", "measuredSignal", "evidenceIds"],
      "properties": {
        "audienceSegment": { "$ref": "#/$defs/nonEmptyString" },
        "exactDiscoveryLocation": { "$ref": "#/$defs/nonEmptyString" },
        "nativeFormat": { "$ref": "#/$defs/nonEmptyString" },
        "ownedRelationship": { "$ref": "#/$defs/nonEmptyString" },
        "measuredSignal": { "type": "string", "minLength": 1, "pattern": "\\d" },
        "evidenceIds": { "$ref": "#/$defs/idList" }
      }
    },
    "transformationDemoRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshotPath", "fifteenSecondScript", "transformationShown", "whyNotVitamin"],
      "properties": {
        "screenshotPath": { "$ref": "#/$defs/nonEmptyString" },
        "fifteenSecondScript": { "type": "string", "minLength": 24 },
        "transformationShown": { "type": "string", "minLength": 16 },
        "whyNotVitamin": { "type": "string", "minLength": 16 }
      }
    },
    "distributionFirstNicheRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payingAudience", "namedChannel", "purchasesAsValidation"],
      "properties": {
        "payingAudience": { "type": "string", "minLength": 12 },
        "namedChannel": { "type": "string", "minLength": 12 },
        "purchasesAsValidation": { "type": "string", "minLength": 12 }
      }
    },
    "verdictRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "categoryRevenueReality", "wedge", "demandSignal", "distributionProof", "offerTest", "verdict", "decidedBy"],
      "properties": {
        "date": { "$ref": "#/$defs/isoDate" },
        "categoryRevenueReality": { "$ref": "#/$defs/nonEmptyString" },
        "wedge": { "$ref": "#/$defs/nonEmptyString" },
        "demandSignal": { "$ref": "#/$defs/nonEmptyString" },
        "distributionProof": { "$ref": "#/$defs/nonEmptyString" },
        "offerTest": { "$ref": "#/$defs/nonEmptyString" },
        "verdict": { "enum": ["go", "pivot", "kill"] },
        "decidedBy": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
