{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifactId",
          "path",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workflowId",
    "outputs"
  ],
  "additionalProperties": false
}
