                    "deferrable": {
                      "type": "boolean"
                    },
                    "appliesToRevision": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "truncated": {
                      "type": "boolean"
                    }
