{
  "name": "b2c-expo-consumer-starter-fixture",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated Expo TypeScript starter. Local Metro/web export is the runnable proof. No shipped lockfile. Not Expo Go proof.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.14",
    "b2c-native-capability": "file:modules/b2c-native-capability",
    "expo": "57.0.17",
    "expo-constants": "57.0.17",
    "expo-dev-client": "57.0.16",
    "expo-haptics": "57.0.2",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
