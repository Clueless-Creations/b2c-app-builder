{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "activated"
                },
                "planId": {
                  "type": "string"
                },
                "configurationRevision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "idempotent": {
                  "type": "boolean"
                }
              },
              "required": [
                "status",
                "planId",
                "configurationRevision",
                "idempotent"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "restored"
                },
                "planId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "planId"
              ],
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
