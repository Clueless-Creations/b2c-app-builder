{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export-localized output",
  "type": "object",
  "properties": {
    "ok": { "const": true },
    "mode": { "const": "export" },
    "notCaptureEvidence": { "const": true },
    "composed": { "type": "string", "minLength": 1 },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "dir": { "type": "string", "minLength": 1 },
          "provenance": { "const": "provenance.json" },
          "outputs": { "type": "integer", "minimum": 1 }
        },
        "required": ["locale", "dir", "provenance", "outputs"],
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["ok", "mode", "notCaptureEvidence", "composed", "locales", "warnings"],
  "additionalProperties": false
}
