{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Go",
        "Pivot",
        "Kill"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "findingIds": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "apply": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "workspaceId",
    "expectedRevision",
    "decisionId",
    "verdict",
    "rationale"
  ],
  "additionalProperties": false
}
