                  "maximum": 9007199254740991
                },
                "excludedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outstandingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "assessed": {
                  "type": "boolean"
                },
                "nextAction": {
                  "type": "string"
