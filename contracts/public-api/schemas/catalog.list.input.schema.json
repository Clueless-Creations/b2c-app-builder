{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "capability",
        "provider",
        "recipe"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9.-]*$"
    }
  },
  "additionalProperties": false
}
