{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dependencyDigests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "workspaceId",
    "sourcePath"
  ],
  "additionalProperties": false
}
