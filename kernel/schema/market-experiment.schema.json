{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "b2c.market-experiment/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "comparisonKind": {
      "type": "string",
      "const": "exploratory_business_comparison"
    },
    "primaryMetric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "costMetric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "additionalProperties": false
    },
    "decisionHorizon": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "criteria": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minimumExposed": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maximumMissingJoinRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumObservationAgeHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "revision",
        "minimumExposed",
        "maximumMissingJoinRate",
        "maximumObservationAgeHours"
      ],
      "additionalProperties": false
    },
    "participants": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "appId": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "treatment": {
            "type": "string",
            "minLength": 1
          },
          "allocationRecordId": {
            "type": "string",
            "minLength": 1
          },
          "primaryObservationId": {
            "type": "string",
            "minLength": 1
          },
          "costObservationId": {
            "type": "string",
            "minLength": 1
          },
          "cohortObservationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspaceId",
          "appId",
          "environment",
          "hypothesis",
          "treatment",
          "allocationRecordId",
          "primaryObservationId",
          "costObservationId",
          "cohortObservationId"
        ],
        "additionalProperties": false
      }
    },
    "founderDecisionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "hypothesis",
    "comparisonKind",
    "primaryMetric",
    "costMetric",
    "currency",
    "window",
    "decisionHorizon",
    "criteria",
    "participants",
    "founderDecisionIds"
  ],
  "additionalProperties": false,
  "$id": "urn:b2c:core:market-experiment-schema",
  "title": "Market experiment"
}
