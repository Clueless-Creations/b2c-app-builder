                      "founderIntent": {
                        "type": "object",
                        "properties": {
                          "artifact": {
                            "type": "string",
                            "const": "operations/FOUNDER_BRIEF.md"
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "characterCount": {
                            "type": "integer",
                            "minimum": 0,
