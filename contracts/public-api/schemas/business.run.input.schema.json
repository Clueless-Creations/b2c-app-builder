{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "scope": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "wallClockSeconds": {
      "default": 300,
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "maxConcurrency": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "required": [
    "workspaceId",
    "expectedRevision",
    "requestId"
  ],
  "additionalProperties": false
}
