{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "queryId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "needs_collection",
                "needs_reconciliation",
                "stale",
                "reusable"
              ]
            },
            "observation": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "providerVersion": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "connectionRef": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "operation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "parameters": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "maxLength": 100
                          },
                          "additionalProperties": true
                        }
                      },
                      "required": [
                        "provider",
                        "providerVersion",
                        "connectionRef",
                        "operation",
                        "parameters"
                      ],
                      "additionalProperties": true
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "observed",
                        "uncertain",
                        "failed"
                      ]
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    "sourceRefs": {
                      "default": [],
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "providerRequestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "refreshReason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "schemaVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "queryId": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "sequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "recordedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query",
                    "outcome",
                    "summary",
                    "sourceRefs",
                    "schemaVersion",
                    "queryId",
                    "sequence",
                    "recordedAt",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "authorityGranted": {
              "type": "boolean",
              "const": false
            },
            "acceptedProof": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "workspaceId",
            "revision",
            "queryId",
            "status",
            "observation",
            "authorityGranted",
            "acceptedProof"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
