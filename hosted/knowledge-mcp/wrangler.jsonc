{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "b2c-app-builder-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.clueless-creations.com", "custom_domain": true }],
  "preview_urls": false,
  "vars": {
    "B2C_APP_BUILDER_PUBLIC_ORIGIN": "https://mcp.clueless-creations.com",
    "B2C_APP_BUILDER_TRUSTED_REDIRECTS": ["https://chatgpt.com/connector_platform_oauth_redirect", "https://claude.ai/api/mcp/auth_callback"],
    "B2C_APP_BUILDER_ALLOWED_ORIGINS": ["https://chatgpt.com", "https://claude.ai"]
  },
  "secrets": { "required": ["B2C_APP_BUILDER_AUTH_SECRET"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "clueless-creations", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "ratelimits": [
    { "name": "INGRESS_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
