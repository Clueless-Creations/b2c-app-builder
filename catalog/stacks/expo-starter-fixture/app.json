{
  "expo": {
    "name": "Expo Consumer Fixture",
    "slug": "expo-consumer-fixture",
    "scheme": "expoconsumerfixture",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "app.example.expoconsumerfixture"
    },
    "android": {
      "package": "app.example.expoconsumerfixture"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-dev-client"],
    "extra": {
      "b2cNativeDirectoryOwnership": "generated-cng"
    }
  }
}
