                  "detail": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "detailTruncated": {
                    "type": "boolean"
                  },
                  "lastFailure": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
