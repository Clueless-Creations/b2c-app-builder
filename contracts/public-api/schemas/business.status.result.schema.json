{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "workspaceId": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "lifecycle": {
              "type": "string",
              "enum": [
                "missing",
                "not_initialized",
                "initialized",
                "run_recorded",
                "unreadable",
                "recovery_required"
              ]
            },
            "work": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "pending": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "active": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "waitingForFounder": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "blocked": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "excluded": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "unknown": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "total",
                    "pending",
                    "active",
                    "waitingForFounder",
                    "blocked",
                    "completed",
                    "failed",
                    "excluded",
                    "unknown"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "resume": {
              "type": "object",
              "properties": {
                "researchQueries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "queryId": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "observed",
                          "uncertain",
                          "failed"
                        ]
                      },
                      "observedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "queryId",
                      "path",
                      "outcome",
                      "observedAt"
                    ],
                    "additionalProperties": true
                  }
                },
                "omittedQueryCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "workflowId": {
                  "type": "string",
                  "const": "workflow.research.research-backed-spec"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "present": {
                        "type": "boolean"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "contentSha256": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "acceptance": {
                        "type": "string",
                        "const": "not_evaluated"
                      }
                    },
                    "required": [
                      "path",
                      "present",
                      "bytes",
                      "contentSha256",
                      "acceptance"
                    ],
                    "additionalProperties": true
                  }
                },
                "businessComplete": {
                  "type": "boolean",
                  "const": false
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "researchQueries",
                "omittedQueryCount",
                "workflowId",
                "artifacts",
                "businessComplete",
                "nextAction"
              ],
              "additionalProperties": true
            },
            "observedFrom": {
              "type": "string",
              "const": "local_runtime"
            },
            "providerProof": {
              "type": "string",
              "const": "not_observed"
            }
          },
          "required": [
            "workspaceId",
            "lifecycle",
            "work",
            "observedFrom",
            "providerProof"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
