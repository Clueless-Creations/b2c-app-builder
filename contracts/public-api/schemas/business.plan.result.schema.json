                      },
                      "produce": {
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 240
                        }
                      },
                      "verify": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "gateCommands": {
                            "maxItems": 16,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "maxLength": 240
                            }
                          },
                          "failClosed": {
                            "type": "boolean"
