<svg xmlns="http://www.w3.org/2000/svg" width="{{WIDTH}}" height="{{HEIGHT}}" viewBox="0 0 {{WIDTH}} {{HEIGHT}}" lang="{{LOCALE}}" data-capture-id="{{CAPTURE_ID}}" data-composed-by="{{TOOL}}" data-composed-at="{{COMPOSED_AT}}" data-not-capture-evidence="true">
  <title>{{HEADLINE}}</title>
  <desc>Composed marketing asset. Not capture evidence. Source capture: {{CAPTURE_HREF}}</desc>
  <rect width="{{WIDTH}}" height="{{HEIGHT}}" fill="#f4f1ea"/>
  <text x="{{HEADLINE_X}}" y="{{HEADLINE_Y}}" text-anchor="middle" font-family="{{FONT_FAMILY}}" font-size="{{HEADLINE_SIZE}}" font-weight="600" fill="#1d1b17">{{HEADLINE}}</text>
  <rect x="{{FRAME_X}}" y="{{FRAME_Y}}" width="{{FRAME_WIDTH}}" height="{{FRAME_HEIGHT}}" rx="{{FRAME_RADIUS}}" fill="#1d1b17"/>
  <image x="{{CAPTURE_X}}" y="{{CAPTURE_Y}}" width="{{CAPTURE_WIDTH}}" height="{{CAPTURE_HEIGHT}}" href="{{CAPTURE_HREF}}" preserveAspectRatio="xMidYMid meet"/>
</svg>
