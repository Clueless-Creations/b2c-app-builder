{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "completion": {
              "type": "object",
              "properties": {
                "deliveryAccepted": {
                  "type": "boolean"
                },
                "closeoutWorkflowId": {
                  "type": "string"
                },
                "requiredCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "excludedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outstandingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "assessed": {
                  "type": "boolean"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "deliveryAccepted",
                "closeoutWorkflowId",
                "requiredCount",
                "excludedCount",
                "outstandingCount",
                "assessed",
                "nextAction"
              ],
              "additionalProperties": true
            },
            "resume": {
              "type": "object",
              "properties": {
                "researchQueries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "queryId": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "observed",
                          "uncertain",
                          "failed"
                        ]
                      },
                      "observedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "queryId",
                      "path",
                      "outcome",
                      "observedAt"
                    ],
                    "additionalProperties": true
                  }
                },
                "omittedQueryCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "workflowId": {
                  "type": "string",
                  "const": "workflow.research.research-backed-spec"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "present": {
                        "type": "boolean"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "contentSha256": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "acceptance": {
                        "type": "string",
                        "const": "not_evaluated"
                      }
                    },
                    "required": [
                      "path",
                      "present",
                      "bytes",
                      "contentSha256",
                      "acceptance"
                    ],
                    "additionalProperties": true
                  }
                },
                "businessComplete": {
                  "type": "boolean",
                  "const": false
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "researchQueries",
                "omittedQueryCount",
                "workflowId",
                "artifacts",
                "businessComplete",
                "nextAction"
              ],
              "additionalProperties": true
            },
            "workspaceId": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "planId": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "held",
                "not_initialized"
              ]
            },
            "ready": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workflowId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "reasonCode": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "workflowId",
                  "title",
                  "status"
                ],
                "additionalProperties": true
              }
            },
            "held": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workflowId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "reasonCode": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "workflowId",
                  "title",
                  "status"
                ],
                "additionalProperties": true
              }
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "providerObservation": {
              "type": "string",
              "const": "not_requested"
            },
            "authorityGranted": {
              "type": "boolean",
              "const": false
            },
            "nextAction": {
              "type": "string"
            }
          },
          "required": [
            "completion",
            "workspaceId",
            "revision",
            "planId",
            "status",
            "ready",
            "held",
            "completed",
            "providerObservation",
            "authorityGranted",
            "nextAction"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "b2c/v1"
        },
        "requestId": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UNSUPPORTED_VERSION",
                "UNKNOWN_ENTITY",
                "UNKNOWN_WORKSPACE",
                "UNSUPPORTED_ENTITY_VERSION",
                "UNKNOWN_OPERATION",
                "INCOMPATIBLE_BINDING",
                "COMPOSITION_APPLY_UNAVAILABLE",
                "INTERNAL_ERROR",
                "LOCAL_OPERATION_REFUSED",
                "RECOVERY_REQUIRED",
                "STALE_PREVIEW"
              ]
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "recovery": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "fields",
            "retryable",
            "recovery"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "apiVersion",
        "requestId",
        "warnings",
        "ok",
        "error"
      ],
      "additionalProperties": true
    }
  ]
}
