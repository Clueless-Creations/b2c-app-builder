{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:b2c-app-builder:schema:component-contract",
  "title": "Portable component contract front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "purpose", "maturity", "states", "requirements", "accessibility", "tokenIds"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/text" },
    "category": { "$ref": "#/$defs/slug" },
    "purpose": { "$ref": "#/$defs/text" },
    "maturity": { "const": "specified" },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    },
    "accessibility": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    },
    "tokenIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tokenId" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "tokenId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
